# https://docs.github.com/en/rest/repos/repos?apiVersion=2022-11-28#transfer-a-repository

# Use by
# Community Portal
# File: pkg/github/github.go
# Function: TransferRepository
# Scope: *

###
# Headers
# @prompt token Enter your github token:

# Path parameters
# @prompt owner Enter the repository owner: 
# @prompt repo Enter the repository name: 

# Body parameters
# @prompt new_owner Enter the new owner for the repository:

POST https://api.github.com/repos/{{owner}}/{{repo}}/transfer
Accept: application/vnd.github+json
Authorization: Bearer {{token}}
X-GitHub-Api-Version: 2022-11-28
X-Github-Next-Global-ID: 1

{
  "new_owner": "{{new_owner}}"
}