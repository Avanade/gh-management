# https://docs.github.com/en/rest/orgs/members?apiVersion=2022-11-28#create-an-organization-invitation

# Use by
# Community Portal
# File: pkg/github/github.go
# Function: OrganizationInvitation
# Scope: *

###
# Path parameters
# @prompt username Enter the username of the user to invite.

# @name user
GET https://api.github.com/users/{{username}}
Accept: application/vnd.github+json
X-GitHub-Api-Version: 2022-11-28

###
# Headers
# @prompt token Enter your github token:

# Path parameters
# @prompt org Enter the organization name.

# Body parameters
# @prompt role Enter the role for the new member. Can be one of: reinstate, admin, direct_member, billing_manager.

@invitee_id = {{ user.response.body.$.id }}

POST https://api.github.com/orgs/{{org}}/invitations
Accept: application/vnd.github+json
Authorization: Bearer {{token}}
X-GitHub-Api-Version: 2022-11-28
X-Github-Next-Global-ID: 1

{
  "invitee_id": {{invitee_id}},
  "role": "{{role}}"
}