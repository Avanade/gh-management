# https://docs.github.com/en/rest/orgs/members?apiVersion=2022-11-28#get-organization-membership-for-a-user

# Use by
# Community Portal
# File: pkg/github/github.go
# Function: UserMembership
# Scope: *

###
# Headers
# @prompt token Enter your github token:

# Path parameters
# @prompt org Enter the organization name:
# @prompt username Enter the username of the user:

GET https://api.github.com/orgs/{{org}}/memberships/{{username}}
Accept: application/vnd.github.v3+json
Authorization: Bearer {{token}}
X-GitHub-Api-Version: 2022-11-28
X-Github-Next-Global-ID: 1
