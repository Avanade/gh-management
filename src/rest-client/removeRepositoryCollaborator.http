# https://docs.github.com/en/rest/collaborators/collaborators?apiVersion=2022-11-28#remove-a-repository-collaborator

# Use by
# Community Portal
# File: pkg/github/github.go
# Function: RemoveCollaborator
# Scope: *

###
# Headers
# @prompt token Enter your github token:

# Path parameters
# @prompt owner Enter the repository owner:
# @prompt repo Enter the repository name:
# @prompt username Enter the collaborator's username:

DELETE https://api.github.com/repos/{{owner}}/{{repo}}/collaborators/{{username}}
Accept: application/vnd.github+json
Authorization: Bearer {{token}}
X-GitHub-Api-Version: 2022-11-28
X-Github-Next-Global-ID: 1
