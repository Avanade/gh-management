# https://docs.github.com/en/rest/teams/members?apiVersion=2022-11-28#add-or-update-team-membership-for-a-user

# Use by
# Community Portal
# File: pkg/github/github.go
# Function: AddMemberToTeam
# Scope: Enterprise Organization

###
# Headers
# @prompt token Enter your github token:

# Path parameters
# @prompt org Enter your github organization:
# @prompt team_slug Enter your github team slug:
# @prompt username Enter the github username:

# Body parameters
# @prompt role Enter the role for the user in the team:

PUT https://api.github.com/orgs/{{org}}/teams/{{team_slug}}/memberships/{{username}}
Accept: application/vnd.github+json
Authorization: Bearer {{token}}
X-GitHub-Api-Version: 2022-11-28
X-Github-Next-Global-ID: 1

{
    "role": "{{role}}"
}
